# ===============================================
# Dawaii Android App - Environment Configuration
# ===============================================
#
# نسخ هذا الملف إلى .env واملأ القيم الحقيقية
# cp .env.example .env
#
# ⚠️ تحذير: لا تضف ملف .env إلى git!
# تأكد من إضافة .env في .gitignore
#
# ===============================================

# ===============================================
# BACKEND CONFIGURATION
# ===============================================

# Development Backend URL
DEV_BASE_URL=https://localhost:8000

# Production Backend URL
PROD_BASE_URL=https://dawaii.com

# Current Environment (development | production)
ENVIRONMENT=development

# API Timeout (milliseconds)
API_TIMEOUT=30000

# Max Retry Attempts
MAX_RETRIES=3

# Retry Delay (seconds)
RETRY_DELAY=2

# ===============================================
# FIREBASE CONFIGURATION
# ===============================================

# Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# FCM Server Key (للـ backend)
FCM_SERVER_KEY=your-fcm-server-key

# Firebase Analytics Enabled
FIREBASE_ANALYTICS_ENABLED=true

# ===============================================
# SECURITY CONFIGURATION
# ===============================================

# Enable SSL Certificate Pinning (true | false)
ENABLE_SSL_PINNING=false

# SSL Certificates (comma-separated SHA-256 hashes)
# احصل عليها من: openssl s_client -connect dawaii.com:443 < /dev/null 2>/dev/null | openssl x509 -fingerprint -sha256 -noout
SSL_CERTIFICATES=sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Enable Secure Storage Encryption
ENABLE_SECURE_STORAGE=true

# Biometric Authentication Enabled
ENABLE_BIOMETRIC_AUTH=false

# ===============================================
# FEATURES FLAGS
# ===============================================

# Enable Video Consultations
ENABLE_VIDEO_CONSULTATIONS=false

# Enable Chat Support
ENABLE_CHAT_SUPPORT=true

# Enable Offline Mode
ENABLE_OFFLINE_MODE=false

# Enable Health Tracking
ENABLE_HEALTH_TRACKING=true

# Enable Prescription Scanning
ENABLE_PRESCRIPTION_SCAN=false

# ===============================================
# PAYMENT CONFIGURATION
# ===============================================

# Payment Gateway
PAYMENT_GATEWAY=none

# Payment Gateway API Key
PAYMENT_API_KEY=

# Enable COD (Cash on Delivery)
ENABLE_COD=true

# ===============================================
# ANALYTICS & MONITORING
# ===============================================

# Sentry DSN (للـ crash reporting)
SENTRY_DSN=

# Sentry Environment
SENTRY_ENVIRONMENT=development

# Enable Crashlytics
ENABLE_CRASHLYTICS=false

# Enable Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=false

# ===============================================
# LOCALIZATION
# ===============================================

# Default Language (ar | en)
DEFAULT_LANGUAGE=ar

# Supported Languages (comma-separated)
SUPPORTED_LANGUAGES=ar,en

# RTL Support
ENABLE_RTL=true

# ===============================================
# CACHE CONFIGURATION
# ===============================================

# Cache Expiry Duration (hours)
CACHE_EXPIRY_HOURS=24

# Max Cache Size (MB)
MAX_CACHE_SIZE_MB=100

# Enable Image Caching
ENABLE_IMAGE_CACHE=true

# ===============================================
# NOTIFICATION CONFIGURATION
# ===============================================

# Enable Local Notifications
ENABLE_LOCAL_NOTIFICATIONS=true

# Enable Push Notifications
ENABLE_PUSH_NOTIFICATIONS=true

# Medication Reminder Enabled
ENABLE_MEDICATION_REMINDERS=true

# Reminder Before Minutes (comma-separated)
REMINDER_BEFORE_MINUTES=15,30,60

# ===============================================
# DEBUG & LOGGING
# ===============================================

# Enable Debug Mode
DEBUG_MODE=true

# Log Level (verbose | debug | info | warning | error)
LOG_LEVEL=debug

# Enable Network Logging
ENABLE_NETWORK_LOGS=true

# Enable Performance Logs
ENABLE_PERFORMANCE_LOGS=false

# ===============================================
# THIRD-PARTY SERVICES
# ===============================================

# Google Maps API Key
GOOGLE_MAPS_API_KEY=

# OneSignal App ID (للإشعارات البديلة)
ONESIGNAL_APP_ID=

# ===============================================
# TESTING
# ===============================================

# Enable Test Mode
TEST_MODE=false

# Mock API Responses
MOCK_API_RESPONSES=false

# Test User Credentials
TEST_USER_MOBILE=0500000000
TEST_USER_PASSWORD=Test@123456
